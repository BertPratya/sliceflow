#!/bin/sh
# Runs the Go checks before a commit, only when the commit includes Go files.
# Turn on once per clone: git config core.hooksPath .githooks
git diff --cached --name-only | grep -qE '(\.go|go\.mod|go\.sum)$' || exit 0
[ -f go.mod ] || exit 0

dirs=""
for d in cmd internal; do [ -d "$d" ] && dirs="$dirs $d"; done
if [ -n "$dirs" ]; then
  out=$(gofmt -l $dirs)
  if [ -n "$out" ]; then
    echo "pre-commit: these files need gofmt -w:" >&2
    echo "$out" >&2
    exit 1
  fi
fi
go vet ./... || exit 1
go test ./... || exit 1
